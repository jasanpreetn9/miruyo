// The Worker that serves the site (Cloudflare Workers, with static assets).
// The SvelteKit adapter fills in the entry point and the assets directory.
// The custom domain is set in the Cloudflare dashboard, so a copy of the repo
// deploys under its own (see README.md).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "miruyo",
	"compatibility_date": "2026-11-01",
	"observability": { "enabled": true },
	// AniList has blocked this Worker's requests, so the server doesn't ask it
	// for anything: public pages load their data in the browser, and the title
	// sitemaps answer 503. Remove this once the block is lifted. It lives here,
	// not in the dashboard, because each deploy replaces the dashboard's values.
	"vars": { "SSR_ANILIST": "off" }
}
