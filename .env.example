# Your AniList API client's id (anilist.co/settings/developer). Its redirect
# URL must be <origin>/api/callback, e.g. http://localhost:5173/api/callback.
# Copy this file to .env for local development.
PUBLIC_ANILIST_CLIENT_ID=

# The site's public origin, for canonical links, share cards, the sitemap and
# robots.txt. Leave it empty locally; set it for a deployment, e.g.
# https://example.com (a Cloudflare build fails without it).
PUBLIC_SITE_URL=

# Dev only, optional: start signed in with this AniList token (copy
# anilist_token from a signed-in browser's localStorage). Never set it on a
# deployment: public variables ship in the client bundle.
PUBLIC_DEV_ANILIST_TOKEN=

# Optional: set to off to skip the server's AniList fetch on public pages
# (title, season chart, schedule), which then load in the browser only.
SSR_ANILIST=
